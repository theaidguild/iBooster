{
  "cli": {
    "version": ">= 16.17.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "cache": {
        "disabled": false,
        "cacheDefaultPaths": true,
        "paths": ["ios/Pods/**", "node_modules/**"]
      }
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "cache": {
        "disabled": false,
        "cacheDefaultPaths": true,
        "paths": ["ios/Pods/**", "node_modules/**"]
      }
    },
    "production": {
      "autoIncrement": true,
      "cache": {
        "disabled": false,
        "cacheDefaultPaths": true,
        "paths": ["ios/Pods/**", "node_modules/**"]
      }
    }
  },
  "submit": {
    "production": {}
  }
}
